# Supabase (https://supabase.com/dashboard) — project Settings → API
# On Vercel: Project → Settings → Environment Variables (add for Production and Preview).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# After applying supabase/migrations/*, create public bucket "email-template-assets"
# (included in 20260328120000_email_assets_and_template_blocks.sql) for template image uploads.

# Microsoft / Outlook — delegated send (Entra app registration, SPA redirect URIs)
# Local:   http://localhost:5173/auth/microsoft/callback
# Vercel:  https://YOUR-PRODUCTION.vercel.app/auth/microsoft/callback
# Pin production callback so preview URLs do not need new Entra entries every deploy:
# VITE_MICROSOFT_REDIRECT_URI=https://YOUR-PRODUCTION.vercel.app/auth/microsoft/callback
# On Vercel, add these with the same names.
VITE_MICROSOFT_CLIENT_ID=
VITE_MICROSOFT_TENANT_ID=

# `true` = always load demo companies/contacts/templates. `false` = always start empty.
# Omit: demo data in local dev only; production builds start empty (real data = Supabase + sync, or backup import).
# VITE_DEMO_DATA=false
